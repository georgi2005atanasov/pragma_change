# Use scripts/setup-env.py to generate private values. Do not use these placeholders.
POSTGRES_PASSWORD=replace_with_random_value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_at_least_12_characters
TRAINER_TOKEN=replace_with_random_service_token
PARTITION_SECRET=replace_with_64_hex_characters
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Local development overrides:
# DATABASE_URL=postgres://pragma:password@127.0.0.1:5432/pragma
# TRAINER_URL=http://127.0.0.1:8001
# API_URL=http://127.0.0.1:8080
# ARTIFACT_DIR=/absolute/path/to/pragma_change/artifacts
# BIND_ADDR=127.0.0.1:8080

# Optional remote management and Claude: a private file containing 64 hex characters.
# For containers, bind-mount this file read-only and use its container path.
CREDENTIAL_KEY_FILE=/absolute/private/path/credential-key
# Optional separate behavior service (see compose.behavior.yaml).
BEHAVIOR_URL=http://127.0.0.1:8090
BEHAVIOR_ADMIN_TOKEN=generate-a-distinct-random-token
BEHAVIOR_PARTITION_SECRET=generate-64-hex-characters
BEHAVIOR_DB_PASSWORD=generate-a-distinct-random-password
