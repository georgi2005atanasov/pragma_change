FROM rust:1.98-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docs ./docs
COPY deploy ./deploy
COPY nginx ./nginx
COPY include ./include
COPY scripts/build-nginx.sh ./scripts/build-nginx.sh
RUN scripts/build-nginx.sh
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && mkdir -p /usr/local/nginx/logs /usr/local/nginx/modules
COPY --from=builder /src/build/nginx/sbin/nginx /usr/local/bin/nginx
COPY --from=builder /src/build/nginx/modules/ngx_http_pragmachange_module.so /usr/local/nginx/modules/
COPY deploy/nginx.conf /etc/nginx/nginx.conf
CMD ["nginx","-p","/usr/local/nginx/","-c","/etc/nginx/nginx.conf","-g","daemon off;"]
