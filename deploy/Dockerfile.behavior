FROM rust:1.98-bookworm AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docs ./docs
COPY examples ./examples
COPY deploy ./deploy
RUN cargo build --locked --release -p pragma-behavior
FROM debian:bookworm-slim
RUN useradd --system --uid 10002 pragma
COPY --from=builder /src/target/release/pragma-behavior /usr/local/bin/pragma-behavior
USER pragma
ENV BEHAVIOR_BIND_ADDR=0.0.0.0:8090
CMD ["pragma-behavior"]
